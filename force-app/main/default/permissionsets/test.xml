<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
   <apiVersion>57.0</apiVersion>
   <description>Automatically excludes user stories from overlap awareness and pipeline when back-promoted to all environments</description>
   <interviewLabel>Auto Exclude Completed User Stories {!$Flow.CurrentDateTime}</interviewLabel>
   <label>Auto Exclude Completed User Stories</label>
   <processMetadataValues>
       <name>BuilderType</name>
       <value>
           <stringValue>LightningFlowBuilder</stringValue>
       </value>
   </processMetadataValues>
   <processType>AutoLaunchedFlow</processType>
   <start>
       <object>copado__Promoted_User_Story__c</object>
       <connector>
           <targetReference>Get_Pipeline_Connections</targetReference>
       </connector>
       <filterLogic>and</filterLogic>
       <filters>
           <field>copado__Status__c</field>
           <operator>EqualTo</operator>
           <value>
               <stringValue>Completed</stringValue>
           </value>
       </filters>
       <filters>
           <field>copado__Back_Promotion__c</field>
           <operator>EqualTo</operator>
           <value>
               <booleanValue>true</booleanValue>
           </value>
       </filters>
       <filters>
           <field>copado__User_Story__r.Exclusion_Flags_Updated__c</field>
           <operator>EqualTo</operator>
           <value>
               <booleanValue>false</booleanValue>
           </value>
       </filters>
       <triggerType>AfterSave</triggerType>
   </start>
  
   <recordLookups>
       <name>Get_Pipeline_Connections</name>
       <label>Get Pipeline Connections</label>
       <locationX>176</locationX>
       <locationY>188</locationY>
       <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
       <connector>
           <targetReference>Get_Completed_Back_Promotions</targetReference>
       </connector>
       <filterLogic>and</filterLogic>
       <filters>
           <field>copado__Pipeline__c</field>
           <operator>EqualTo</operator>
           <value>
               <elementReference>$Record.copado__Pipeline__c</elementReference>
           </value>
       </filters>
       <filters>
           <field>copado__Active__c</field>
           <operator>EqualTo</operator>
           <value>
               <booleanValue>true</booleanValue>
           </value>
       </filters>
       <object>copado__Pipeline_Connection__c</object>
       <storeResults>pipelineConnections</storeResults>
   </recordLookups>
  
   <recordLookups>
       <name>Get_Completed_Back_Promotions</name>
       <label>Get Completed Back Promotions</label>
       <locationX>176</locationX>
       <locationY>288</locationY>
       <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
       <connector>
           <targetReference>Check_Back_Promotion_Complete</targetReference>
       </connector>
       <filterLogic>and</filterLogic>
       <filters>
           <field>copado__User_Story__c</field>
           <operator>EqualTo</operator>
           <value>
               <elementReference>$Record.copado__User_Story__c</elementReference>
           </value>
       </filters>
       <filters>
           <field>copado__Back_Promotion__c</field>
           <operator>EqualTo</operator>
           <value>
               <booleanValue>true</booleanValue>
           </value>
       </filters>
       <filters>
           <field>copado__Status__c</field>
           <operator>EqualTo</operator>
           <value>
               <stringValue>Completed</stringValue>
           </value>
       </filters>
       <object>copado__Promoted_User_Story__c</object>
       <storeResults>completedBackPromotions</storeResults>
   </recordLookups>
  
   <decisions>
       <name>Check_Back_Promotion_Complete</name>
       <label>Check Back Promotion Complete</label>
       <locationX>176</locationX>
       <locationY>388</locationY>
       <defaultConnector>
           <targetReference>Create_Error_Task</targetReference>
       </defaultConnector>
       <defaultConnectorLabel>Not Complete</defaultConnectorLabel>
       <rules>
           <name>Back_Promotion_Complete</name>
           <conditionLogic>and</conditionLogic>
           <conditions>
               <operator>GreaterThanOrEqualTo</operator>
               <rightValueReference>pipelineConnections.Count</rightValueReference>
           </conditions>
           <connector>
               <targetReference>Update_User_Story</targetReference>
           </connector>
           <label>Complete</label>
       </rules>
   </decisions>
  
   <recordUpdates>
       <name>Update_User_Story</name>
       <label>Update User Story</label>
       <locationX>176</locationX>
       <locationY>488</locationY>
       <filterLogic>and</filterLogic>
       <filters>
           <field>Id</field>
           <operator>EqualTo</operator>
           <value>
               <elementReference>$Record.copado__User_Story__c</elementReference>
           </value>
       </filters>
       <inputAssignments>
           <field>copado__Exclude_From_CBM__c</field>
           <value>
               <booleanValue>true</booleanValue>
           </value>
       </inputAssignments>
       <inputAssignments>
           <field>Exclusion_Flags_Updated__c</field>
           <value>
               <booleanValue>true</booleanValue>
           </value>
       </inputAssignments>
       <object>copado__User_Story__c</object>
   </recordUpdates>
  
   <recordCreates>
       <name>Create_Error_Task</name>
       <label>Create Error Task</label>
       <locationX>396</locationX>
       <locationY>388</locationY>
       <inputAssignments>
           <field>OwnerId</field>
           <value>
               <elementReference>$User.Id</elementReference>
           </value>
       </inputAssignments>
       <inputAssignments>
           <field>Description</field>
           <value>
               <stringValue>Error occurred while processing User Story: {!$Record.copado__User_Story__c}</stringValue>
           </value>
       </inputAssignments>
       <object>Task</object>
   </recordCreates>
  
   <status>Active</status>
</Flow>